# Postgres (metadata / controle / observabilidade)
POSTGRES_DB=radar_contratos
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO (data lake local S3)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_LAKE_BUCKET=radar-lake
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000

# Airflow
AIRFLOW_PORT=8081
AIRFLOW_SECRET_KEY=dev_secret_key
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@local
AIRFLOW_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-amazon==8.25.0 requests==2.32.3 boto3==1.35.36 psycopg2-binary==2.9.9

# PNCP ingest
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao
PNCP_TIMEOUT_SECONDS=30
PNCP_PAGE_SIZE=100
PNCP_MAX_PAGES=500
PNCP_REPROCESS_DAYS=7
PNCP_BACKFILL_MONTHS=12

# Streamlit
STREAMLIT_PORT=8501
